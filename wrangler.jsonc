{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas",
      "database_id": "5b2e6ecd-b1af-464e-8da5-1e5f3e58c4f8"
    }
  ]
}
